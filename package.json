{
	"name": "@twin.org/workspace",
	"version": "0.0.0",
	"description": "Workspace",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/twin-workspace.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"private": true,
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"package:update": "pnpm update --interactive --latest",
		"submodule:install": "node ./scripts/submodules.mjs install",
		"submodule:format": "node ./scripts/submodules.mjs format",
		"submodule:lint": "node ./scripts/submodules.mjs lint",
		"submodule:lint:code": "node ./scripts/submodules.mjs lint:code",
		"submodule:dist": "node ./scripts/submodules.mjs dist",
		"submodule:dist-no-test": "node ./scripts/submodules.mjs dist-no-test",
		"submodule:test": "node ./scripts/submodules.mjs test",
		"submodule:docs": "node ./scripts/submodules.mjs docs",
		"submodule:quality": "node ./scripts/submodules.mjs quality",
		"submodule:quality-no-test": "node ./scripts/submodules.mjs quality-no-test",
		"submodule:format-lint-dist-docs": "node ./scripts/submodules.mjs format-lint-dist-docs",
		"submodule:package-update": "node ./scripts/submodules.mjs package-update",
		"submodule:align-main": "node ./scripts/submodule-align.mjs main",
		"submodule:align-next": "node ./scripts/submodule-align.mjs next"
	},
	"submodules": [
		"twin-framework",
		"twin-tools",
		"twin-data",
		"twin-standards",
		"twin-api",
		"twin-entity-storage",
		"twin-logging",
		"twin-telemetry",
		"twin-tracing",
		"twin-event-bus",
		"twin-vault",
		"twin-blob-storage",
		"twin-automation",
		"twin-background-task",
		"twin-data-processing",
		"twin-messaging",
		"twin-trust",
		"twin-dlt",
		"twin-wallet",
		"twin-identity",
		"twin-nft",
		"twin-notarization",
		"twin-hierarchies",
		"twin-verifiable-storage",
		"twin-synchronised-storage",
		"twin-immutable-proof",
		"twin-attestation",
		"twin-auditable-item-graph",
		"twin-auditable-item-stream",
		"twin-document-management",
		"twin-rights-management",
		"twin-federated-catalogue",
		"twin-dataspace",
		"twin-engine",
		"twin-node"
	],
	"type": "module",
	"devDependencies": {
		"@octokit/rest": "22.0.1",
		"glob": "13.0.6",
		"prettier": "3.9.8"
	},
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/twin-workspace/issues"
	},
	"homepage": "https://twindev.org"
}
